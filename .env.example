# Environment Configuration for Marketplace Intelligence & Price Radar

# Next.js Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Neon Serverless Postgres (Leave empty for graceful offline mock)
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=

# Redis Cache & Rate Limiting (Docker / Local / Remote)
# If empty or unreachable, system automatically falls back to in-memory LRU cache
REDIS_URL=redis://localhost:6379

# Rate Limiting Settings
RADAR_SEARCH_RATE_LIMIT_PER_MINUTE=20
RADAR_CLICK_RATE_LIMIT_PER_MINUTE=60

# Marketplace Affiliate & Partner Credentials (Optional for mock/prototype)
# Shopee Affiliate Open API
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_APP_SECRET=

# TikTok Shop Partner / Affiliate API
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_ACCESS_TOKEN=

# Lazada Open Platform / LazAffiliates
LAZADA_APP_KEY=
LAZADA_APP_SECRET=

# Tokopedia Affiliate
TOKOPEDIA_CLIENT_ID=
TOKOPEDIA_CLIENT_SECRET=
